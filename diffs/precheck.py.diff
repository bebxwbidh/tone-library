+# ===== 影调一致性检查（2026-11-11 立，references/23 影调库 V1 / A方案）=====
+# 设计原则：
+#   1) 兼容旧格式——目录里没有 tone.lock.json 且所有帧都没写【影调:】标签时，
+#      影调检查整体静默跳过，旧行为零变化；
+#   2) master_tone_id 用首行元信息标签【影调:tone-XXXXXXXX-NN】声明（同【景别:XX】，
+#      组层面元信息，剥离后不计入 250 token 正文预算）；
+#   3) 套级锁定文件 tone.lock.json（放提示词目录）声明 master_tone_id + 可选签名词，
+#      帧标签与锁定文件不一致 = 未经授权的影调切换，FAIL；
+#   4) 静态检查只保证提示词层一致——成片影调必须另走 光检.py --ref + 并排目检，
+#      提示词通过 ≠ 成片通过（输出区固定提醒，不可关闭）。
+RE_TONE_TAG = re.compile(r"【影调[:：]\s*([^】\n]+)】")
+# 冷暖倾向词（按 05 号白平衡铁律 / 22 号审美基准的用词收集）。
+# 单帧内同时出现冷暖（如「冷调环境+肤色暖意」是 22 号合法写法）不算矛盾；
+# 矛盾判定在**帧与帧之间**：warm 主导帧与 cool 主导帧并存 = 冷暖漂移。
+TONE_WARM_WORDS = ["暖金", "金黄", "金色", "夕阳", "落日", "暖调", "暖棕", "暖肤", "琥珀", "黄昏暖", "暖意"]
+TONE_COOL_WORDS = ["冷调", "冷白", "蓝调", "冷蓝", "冰蓝", "青冷", "冷青", "冷色", "偏冷"]
+# 肤色改写禁词：影调档案只许描述皮肤与环境的关系，不许强制改肤（07 号：不强制美白/染色）
+SKIN_ALTER_WORDS = ["美白", "古铜", "小麦色", "蜜色", "晒黑", "增白"]
+# 肤色保护特征词：每帧【人物皮肤】段必须保留真实皮肤规则（07 号四项的落词）
+SKIN_PROTECT_WORDS = ["真实皮肤纹理", "皮肤质感", "不磨皮", "真实质感", "皮肤纹理", "自然肤色"]
+
+
+def strip_tone_tag(txt):
+    return RE_TONE_TAG.sub("", txt)
+
+
+def tone_bucket(txt):
+    """单帧冷暖主导判定。返回 'warm' / 'cool' / 'neutral'（只看【色彩逻辑】段）。"""
+    m = re.search(r"【色彩逻辑】([^\n]*)", txt)
+    seg = m.group(1) if m else ""
+    warm = sum(seg.count(w) for w in TONE_WARM_WORDS)
+    cool = sum(seg.count(w) for w in TONE_COOL_WORDS)
+    if warm > cool:
+        return "warm"
+    if cool > warm:
+        return "cool"
+    return "neutral"
+
+
+def load_tone_lock(prompt_dir):
+    """读取提示词目录下的 tone.lock.json。不存在返回 None。
+    格式：{"master_tone_id": "...", "variation_frames": ["F13"], "core_signature": "",
+           "negative_signature": "", "notes": ""}"""
+    p = os.path.join(prompt_dir, "tone.lock.json")
+    if not os.path.exists(p):
+        return None
+    try:
+        return json.loads(open(p, encoding="utf-8").read())
+    except Exception as e:
+        return {"_error": f"tone.lock.json 解析失败: {e}"}
+
+
+def check_tone_consistency(raw_pairs, prompt_dir):
+    """组层面影调一致性检查（references/23 §5）。
+    raw_pairs = [(未剥离标签的全文, 文件名), ...]。
