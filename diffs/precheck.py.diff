+        leans[short] = tone_bucket(strip_tone_tag(raw))
+    lean_vals = {v for v in leans.values() if v != "neutral"}
+    if len(lean_vals) > 1:
+        warm_f = [k for k, v in leans.items() if v == "warm"]
+        cool_f = [k for k, v in leans.items() if v == "cool"]
+        issues.append(
+            f"FAIL 冷暖矛盾（T3）：warm 主导帧 {','.join(warm_f)} 与 cool 主导帧 {','.join(cool_f)} 并存"
+            f"——同套冷暖不许漂移（references/15 §6 影调锚 + references/05 白平衡铁律）；"
+            f"单帧内「冷环境+暖肤色」合法，帧间主导倾向不许换")
+    # --- T4 主影调核心描述落位 ---
+    sig = (lock or {}).get("core_signature", "")
+    if sig:
+        for raw, fname in raw_pairs:
+            short = fname.replace(".txt", "")
+            m = re.search(r"【色彩逻辑】([^\n]*)", raw)
+            seg = m.group(1) if m else ""
+            if sig not in seg:
+                issues.append(
+                    f"FAIL {short}【色彩逻辑】缺主影调核心描述（T4）："
+                    f"必须包含签名词「{sig}」（来自影调档案 core，references/23 §4）")
+    elif lock:
+        issues.append(
+            "WARN tone.lock.json 未填 core_signature：无法核对每帧是否带了主影调核心描述，"
+            "请在档案 prompt_fragments.core 里挑 6~12 字特征子串填入锁定文件")
+    # --- T5 肤色保护 ---
+    for raw, fname in raw_pairs:
+        short = fname.replace(".txt", "")
+        m = re.search(r"【人物皮肤】([^\n]*)", raw)
+        seg = m.group(1) if m else ""
+        if not any(w in seg for w in SKIN_PROTECT_WORDS):
+            issues.append(
+                f"FAIL {short}【人物皮肤】缺真实肤色保护词（T5）："
+                f"需含「真实皮肤纹理/皮肤质感/不磨皮」其一（references/07）——"
+                f"影调不许接管皮肤标准")
+        m2 = re.search(r"【色彩逻辑】([^\n]*)", raw)
+        seg2 = m2.group(1) if m2 else ""
