+    # --- T1 master_tone_id 唯一性 ---
+    master = (lock or {}).get("master_tone_id", "")
+    if not master and tags:
+        uniq = set(tags.values())
+        if len(uniq) == 1:
+            master = next(iter(uniq))
+        else:
+            issues.append(
+                "FAIL 未经授权的影调切换（T1）：帧间出现多个 master_tone_id——"
+                + "、".join(f"{f}:{t}" for f, t in sorted(tags.items()))
+                + "——一套图只能一个主影调（references/23 §3）；换影调=开新套")
